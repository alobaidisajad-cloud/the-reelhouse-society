# What an EAS build's upload leaves out. eas-cli reads this file INSTEAD of every
# .gitignore, so it must keep out everything they do; easUpload.guard.test.ts
# fails on a .gitignore rule this file does not cover. eas.json's requireCommit
# uploads only the commit, so these rules also trim tracked files from it.

# Heavy folders the build does not need
frames/
trailer-video/
public/social/*.webm
*.webm
*.mp4
dist/
node_modules/
mobile/mockups/
.claude/
mobile/.claude/
mobile/.gemini/
mobile/.kiro/
mobile/.vscode/
mobile/design/
mobile/audit/
mobile/coverage/
mobile/docs/
mobile/e2e/
mobile/test-utils/
mobile/__tests__/
mobile/scratch/
mobile/node_modules/
mobile/.expo/
mobile/*.md
mobile/*.log

# Everything the root .gitignore keeps out (its re-includes left out: they keep
# SQL in git, and the build needs none)
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
build*.log
build_out.txt
build_err.txt
lint_output.txt
eslint_fresh.txt
lighthouse-report.json
lighthouse-report-v2.json
lighthouse-live.json
.lighthouserc.json
.ts_errors.log
