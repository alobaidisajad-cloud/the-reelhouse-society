# Debug / audit artifacts — lint, type-check, and search dumps (never committed)
# Anchored to this folder's root, where the dumps land. Unanchored, `search_*.json`
# matched anywhere in the tree — and silently kept every SEARCH recording of the
# E2E world's TMDB stand-in (e2e/supabase/functions/tmdb-proxy/fixtures) out of
# git: they worked on the machine that recorded them, and the runner never had
# them. theRecordingsTravel.test.ts fails if a recording is ignored again.
/eslint*.txt
/eslint*.json
/lint-results.txt
/tsc*.txt
*-output.txt
*_output.txt
/search_*.txt
/search_*.json
/context_search.txt
/scratch_*.json
*.log

# Local scratch / WIP scripts and dumps (never shipped)
scratch/

# Test coverage reports (generated by jest --coverage)
coverage/

# Generated documentation
docs/
.mockup-preview/
