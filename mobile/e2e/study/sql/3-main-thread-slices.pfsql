-- The main thread's own sections (outermost two levels), numbers stripped from names.
WITH app AS (SELECT upid, pid FROM process WHERE name = 'com.reelhouse.society' ORDER BY upid DESC LIMIT 1),
main AS (SELECT utid FROM thread JOIN app USING (upid) WHERE thread.tid = app.pid),
t0 AS (SELECT MIN(ts) AS ts FROM thread_state WHERE utid = (SELECT utid FROM main))
SELECT RTRIM(s.name, ' 0123456789') AS section, s.depth, COUNT(*) AS n,
       ROUND(SUM(s.dur) / 1e6, 1) AS total_ms, ROUND(MAX(s.dur) / 1e6, 1) AS max_ms
FROM slice s JOIN thread_track tt ON s.track_id = tt.id
WHERE tt.utid = (SELECT utid FROM main) AND s.depth <= 1 AND s.ts < (SELECT ts FROM t0) + 9000000000
GROUP BY section, s.depth ORDER BY total_ms DESC LIMIT 30;
