      "malformed": { "link": "/dispatch/not-an-id", "shows": "ROUTE NOT IN THE ARCHIVE" },
      "missing": { "link": "/dispatch/00000000-0000-4000-8000-000000000000", "shows": "This filing is no longer here." }
    },
