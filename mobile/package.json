{
  "name": "mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "prepare": "node ./scripts/install-hooks.cjs",
    "postinstall": "patch-package --error-on-fail",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "expo lint",
    "check:routes": "node ./scripts/check-app-routes.js",
    "check:backend": "node ./scripts/check-backend-live.mjs",
    "test:e2e": "bash e2e/run-flows.sh",
    "test": "jest",
    "docs:generate": "typedoc",
    "docs:deps": "madge --image docs/dependency-graph.svg --ts-config tsconfig.json src/",
    "test:tz": "node scripts/test-timezones.js",
    "schema:snapshot": "node scripts/schema-snapshot.mjs",
    "schema:check": "node scripts/schema-snapshot.mjs --check",
    "functions:check": "node scripts/functions-check.mjs",
    "gates:check": "node scripts/gates-check.js",
    "comments:check": "node scripts/comment-truth.js",
    "icons": "node scripts/lucide-icons.js",
    "bundle:size": "node scripts/bundle-size.js",
    "release:guard": "node scripts/release-guard.cjs",
    "build:ios": "node scripts/eas-build-preflight.cjs && eas build --platform ios --profile production",
    "build:android": "node scripts/eas-build-preflight.cjs && eas build --platform android --profile production"
  },
  "dependencies": {
    "@expo-google-fonts/courier-prime": "^0.4.1",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/rye": "^0.4.1",
    "@expo-google-fonts/special-elite": "^0.4.1",
    "@expo-google-fonts/spectral": "^0.4.1",
    "@expo/vector-icons": "^15.0.3",
    "@hookform/resolvers": "^5.4.0",
    "@react-native-community/netinfo": "11.5.2",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@sentry/react-native": "^8.16.0",
    "@shopify/flash-list": "2.0.2",
    "@shopify/react-native-skia": "2.4.18",
    "@supabase/supabase-js": "^2.102.1",
    "@tanstack/react-query": "^5.99.0",
    "@tanstack/react-query-persist-client": "^5.99.0",
    "base64-arraybuffer": "^1.0.2",
    "expo": "^55.0.0",
    "expo-blur": "~55.0.18",
    "expo-clipboard": "~55.0.17",
    "expo-constants": "~55.0.17",
    "expo-crypto": "~55.0.19",
    "expo-dev-client": "~55.0.41",
    "expo-device": "~55.0.21",
    "expo-document-picker": "~55.0.17",
    "expo-file-system": "~55.0.26",
    "expo-font": "~55.0.8",
    "expo-haptics": "~55.0.18",
    "expo-image": "~55.0.11",
    "expo-image-manipulator": "~55.0.21",
    "expo-image-picker": "~55.0.24",
    "expo-linear-gradient": "~55.0.18",
    "expo-linking": "~55.0.17",
    "expo-local-authentication": "~55.0.18",
    "expo-notifications": "~55.0.27",
    "expo-router": "~55.0.18",
    "expo-secure-store": "~55.0.18",
    "expo-sharing": "~55.0.25",
    "expo-splash-screen": "~55.0.25",
    "expo-status-bar": "~55.0.6",
    "expo-store-review": "~55.0.18",
    "expo-system-ui": "~55.0.22",
    "expo-updates": "~55.0.33",
    "expo-web-browser": "~55.0.20",
    "jszip": "^3.10.1",
    "lucide-react-native": "^1.7.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-freeze": "^1.0.4",
    "react-hook-form": "^7.76.1",
    "react-native": "0.83.10",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-markdown-display": "^7.0.2",
    "react-native-mmkv": "^3.0.0",
    "react-native-purchases": "^10.0.1",
    "react-native-reanimated": "~4.3.4",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-view-shot": "4.0.3",
    "react-native-webview": "13.16.0",
    "react-native-worklets": "^0.8.3",
    "zod": "^4.6.7",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/jest-runner": "10.0.0",
    "@testing-library/react-native": "^14.0.0",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.10",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~55.0.1",
    "eslint-plugin-tsdoc": "^0.5.2",
    "eslint-plugin-unused-imports": "^4.4.1",
    "fast-check": "^4.8.0",
    "jest-expo": "~55.0.22",
    "madge": "^8.0.0",
    "patch-package": "8.0.1",
    "typedoc": "^0.28.19",
    "typescript": "~5.9.2",
    "yaml": "2.8.3",
    "yoga-layout": "3.2.1"
  },
  "private": true,
  "reanimated": {
    "staticFeatureFlags": {
      "ANDROID_SYNCHRONOUSLY_UPDATE_UI_PROPS": true
    }
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native-reanimated",
        "react-native-worklets",
        "@sentry/react-native"
      ]
    },
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-image"
        ]
      }
    }
  }
}
