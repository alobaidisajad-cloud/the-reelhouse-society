{
  "name": "mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "prepare": "node ./scripts/install-hooks.cjs",
    "postinstall": "patch-package --error-on-fail",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "expo lint",
    "check:routes": "node ./scripts/check-app-routes.js",
    "check:backend": "node ./scripts/check-backend-live.mjs",
    "test:e2e": "bash e2e/run-flows.sh",
    "test": "jest",
    "docs:generate": "typedoc",
    "docs:deps": "madge --image docs/dependency-graph.svg --ts-config tsconfig.json src/",
    "test:tz": "node scripts/test-timezones.js",
    "schema:snapshot": "node scripts/schema-snapshot.mjs",
    "schema:check": "node scripts/schema-snapshot.mjs --check",
    "functions:check": "node scripts/functions-check.mjs",
    "gates:check": "node scripts/gates-check.js",
    "comments:check": "node scripts/comment-truth.js",
    "icons": "node scripts/lucide-icons.js",
    "bundle:size": "node scripts/bundle-size.js",
    "release:guard": "node scripts/release-guard.cjs",
    "build:ios": "node scripts/eas-build-preflight.cjs && eas build --platform ios --profile production",
    "build:android": "node scripts/eas-build-preflight.cjs && eas build --platform android --profile production"
  },
  "dependencies": {
    "@expo-google-fonts/courier-prime": "^0.4.1",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/rye": "^0.4.1",
    "@expo-google-fonts/special-elite": "^0.4.1",
    "@expo-google-fonts/spectral": "^0.4.1",
    "@expo/vector-icons": "^15.0.3",
    "@hookform/resolvers": "^5.4.0",
    "@react-native-community/netinfo": "12.0.1",
    "@sentry/react-native": "^8.16.0",
    "@shopify/flash-list": "2.3.3",
    "@shopify/react-native-skia": "2.14.0",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-query-persist-client": "^5.104.5",
    "base64-arraybuffer": "^1.0.2",
    "expo": "^57.0.23",
    "expo-application": "~57.0.3",
    "expo-blur": "~57.0.3",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.22",
    "expo-crypto": "~57.0.4",
    "expo-dev-client": "~57.0.20",
    "expo-device": "~57.0.2",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "57.0.5",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.13",
    "expo-local-authentication": "~57.0.3",
    "expo-notifications": "~57.0.24",
    "expo-router": "~57.0.29",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.24",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-store-review": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.26",
    "expo-web-browser": "~57.0.3",
    "jszip": "^3.10.2",
    "lucide-react-native": "^1.61.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-freeze": "^1.0.4",
    "react-hook-form": "^7.91.0",
    "react-native": "0.86.3",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-markdown-display": "^7.0.2",
    "react-native-mmkv": "^3.0.0",
    "react-native-purchases": "^10.15.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-view-shot": "5.1.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.13.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.88.0",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/jest-runner": "10.1.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.10",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.61.1",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.2",
    "eslint-plugin-tsdoc": "^0.5.4",
    "eslint-plugin-unused-imports": "^4.4.1",
    "fast-check": "^4.10.2",
    "jest-expo": "~57.0.6",
    "madge": "^8.0.0",
    "patch-package": "8.0.1",
    "typedoc": "^0.28.20",
    "typescript": "~6.0.3",
    "yaml": "2.9.1",
    "yoga-layout": "3.2.1"
  },
  "private": true,
  "overrides": {
    "madge": {
      "typescript": "$typescript"
    }
  },
  "reanimated": {
    "staticFeatureFlags": {
      "ANDROID_SYNCHRONOUSLY_UPDATE_UI_PROPS": true
    }
  },
  "expo": {
    "install": {
      "exclude": [
        "@sentry/react-native"
      ]
    },
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-image"
        ]
      }
    }
  }
}
