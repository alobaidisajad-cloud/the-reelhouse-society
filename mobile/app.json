{
  "expo": {
    "name": "The ReelHouse Society",
    "slug": "reelhouse",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "reelhouse",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.reelhouse.society",
      "buildNumber": "41",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Your Society portrait is chosen from your photos. Only the photo you pick is used.",
        "NSCameraUsageDescription": "The camera takes your Society portrait, when you ask it to.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": false
        }
      }
    },
    "android": {
      "package": "com.reelhouse.society",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0D0B09",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "sitemap": false
        }
      ],
      [
        "expo-dev-client",
        {
          "addGeneratedScheme": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0D0B09",
          "dark": {
            "backgroundColor": "#0D0B09",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#B8891A"
        }
      ],
      "./plugins/withSplashWithoutHandoff",
      "./plugins/withLinkDuringLaunch",
      "./plugins/withLeftToRight",
      "./plugins/withShrunkRelease",
      "./plugins/withHouseDialogs",
      "./plugins/withOneNdk",
      "./plugins/withGwpAsanOff",
      "expo-font",
      [
        "@sentry/react-native",
        {
          "url": "https://sentry.io/",
          "organization": "the-reelhouse-society",
          "project": "react-native",
          "experimental_android": {
            "enableAndroidGradlePlugin": true,
            "autoUploadProguardMapping": true
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "microphonePermission": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Face ID opens your locked Archive, and confirms it is you before its lock changes or your account closes."
        }
      ],
      "expo-web-browser",
      "expo-image",
      "expo-sharing",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9527b5a1-c663-4262-883c-7b85e6aa748d"
      }
    },
    "owner": "thereehouse.society",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/9527b5a1-c663-4262-883c-7b85e6aa748d"
    }
  }
}
