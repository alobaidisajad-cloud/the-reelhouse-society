{
  "expo": {
    "name": "The ReelHouse Society",
    "slug": "reelhouse",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "reelhouse",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.reelhouse.society",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "The ReelHouse requires access to your archives to set your Society portrait."
      }
    },
    "android": {
      "package": "com.reelhouse.society",
      "adaptiveIcon": {
        "backgroundColor": "#0B0A08",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0B0A08",
          "dark": {
            "backgroundColor": "#0B0A08",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "expo-font",
      "@sentry/react-native"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    }
  }
}
