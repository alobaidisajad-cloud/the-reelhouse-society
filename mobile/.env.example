# ReelHouse Mobile — Environment Variables
# ══════════════════════════════════════════
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
#
# S-02 FIX: This file documents all required environment variables
# so new developers can onboard without hunting through the codebase.

# ── Supabase ──────────────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ── TMDB (The Movie Database) ─────────────────────────
# TMDB API key is now server-side only (supabase secrets set TMDB_API_KEY=<key>)

# ── RevenueCat (In-App Purchases) ─────────────────────
EXPO_PUBLIC_REVENUECAT_IOS_KEY=your-revenuecat-ios-key-here
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=your-revenuecat-android-key-here

# ── Sentry (Error Tracking) ──────────────────────────
EXPO_PUBLIC_SENTRY_DSN=your-sentry-dsn-here

# ── API URL ──────────────────────────────────────────
EXPO_PUBLIC_API_URL=https://your-api-url.com
